<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Default Document: Make index.php primary -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Request Filtering: Protect sensitive file extensions and folders -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".accdb" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="database" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- HTTP Headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
